{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobhub-mailer",
  "main": "./src/index.js",
  "compatibility_date": "2025-11-28",
  "observability": { "enabled": true },
  "send_email": [{ "name": "EMAIL", "remote": true }],
  "routes": [{ "pattern": "mailer.chenminghuan.com", "custom_domain": true }]
}
